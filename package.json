{
  "name": "tfs-api",
  "version": "2.9.1",
  "private": true,
  "description": "Trade Finance Services API",
  "license": "MIT",
  "author": "UKEF",
  "workspaces": [
    "tfs-functions"
  ],
  "scripts": {
    "api-test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --selectProjects=API-FF=true --testPathIgnorePatterns=\"gift\"",
    "api-test:acbs": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --selectProjects=API-FF=true --testPathIgnorePatterns=\"gift\"",
    "api-test:ff-false": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --selectProjects=API-FF=false",
    "api-test:gift": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --selectProjects=API-FF=true --testPathPatterns=\"gift\"",
    "audit:fix": "npm audit --fix",
    "build": "nest build -p tsconfig.build.json",
    "housekeeping": "npm update --save && npm i && npm run type-check && npm run prettier:fix && npm run lint:fix && npm run validate:yml && npm run audit:fix && npm run spellcheck",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "prettier": "prettier --no-error-on-unmatched-pattern --check **/*.{ts,js}",
    "prettier:fix": "prettier --write **/*.{ts,js}",
    "snapshot:update": "npm run unit-test -- -u && npm run api-test -- -u",
    "spellcheck": "cspell lint --gitignore --no-must-find-files --unique --no-progress --show-suggestions --color '**/*'",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --tsc --watch",
    "start:prod": "node dist/src/main",
    "type-check": "tsc --noEmit --pretty && npm run type-check --workspace=tfs-functions",
    "unit-test:ff-false": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects=Unit-FF=false",
    "unit-test:ff-true": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects=Unit-FF=true",
    "unit-test-dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose --config=jest.config.ts",
    "validate:all": "npm run lint:fix && npm run prettier:fix && npm run type-check && npm run validate:yml && npm run validate:md",
    "validate:md": "npx markdownlint-cli --config .markdownlint.json \"**/*.md\"",
    "validate:yml": "npx yaml-lint **/*.yml --ignore=**/node_modules"
  },
  "lint-staged": {
    "**/package.json": "sort-package-json",
    "**/*.{js,ts}": [
      "npm run lint:fix",
      "npm run prettier:fix"
    ],
    "**/*.md": [
      "prettier --write",
      "npx markdownlint-cli --config .markdownlint.json"
    ],
    "**/*.yml": [
      "npx yaml-lint --ignore=**/node_modules"
    ],
    "**/*": [
      "cspell lint --gitignore --no-must-find-files --unique --no-progress --show-suggestions --color"
    ]
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@azure/storage-queue": "12.32.0",
    "@nestjs/axios": "12.0.1",
    "@nestjs/cache-manager": "12.0.4",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "axios": "1.21.1",
    "cache-manager": "7.2.9",
    "chance": "1.1.13",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-basic-auth": "1.2.1",
    "globals": "17.14.0",
    "jest-when": "4.0.3",
    "keyv": "6.1.0",
    "luxon": "3.7.2",
    "nestjs-pino": "5.3.1",
    "passport": "0.7.0",
    "passport-headerapikey": "1.2.2",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.15",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.9.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@tsconfig/node21": "21.0.9",
    "@types/chance": "1.1.8",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jest-when": "3.5.5",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@types/supertest": "2.0.16",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "cross-env": "10.1.0",
    "cspell": "10.4.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.50.0",
    "nock": "15.0.6",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "sort-package-json": "4.1.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=11.3.0"
  }
}
